<h2>{{title}}</h2>
{{#can_edit}}
<p><a href="{{baseurl}}thread/edit/{{id}}">Edit thread</a></p>
{{/can_edit}}
<ol class="posts">
{{#posts}}
    <li class="post{{#is_pending}} pending{{/is_pending}}">
        <a id="{{id}}"></a>
        <span class="avatar {{avatar}}">{{initial}}</span>
        <span class="metadata">
            by <a href="{{baseurl}}profile/{{user_id}}">{{username}}</a> on <strong>{{ts_created}}</strong>{{#ts_updated}}, edited <strong>{{ts_updated}}</strong>{{/ts_updated}}
            <a href="{{baseurl}}thread/{{thread_id}}/p{{page}}#{{id}}">#</a>
            {{#is_pending}}
            <strong>Awaiting approval:</strong> only its author and admins can see this post.
            {{#is_admin}}<a href="{{baseurl}}approvals">Review</a>{{/is_admin}}
            {{/is_pending}}
            {{#can_edit}}
            <a href="{{baseurl}}post/edit/{{id}}">edit</a>
            {{/can_edit}}
            {{#can_vote}}
            <form action="{{baseurl}}vote" method="post" class="vote-form">
              <input type="hidden" name="csrf" value="{{csrf}}">
              <input type="hidden" name="post_id" value="{{id}}">
              <input type="hidden" name="page" value="{{page}}">
              <button name="vote" value="1" title="React" aria-pressed="{{#user_vote_is_upvoted}}true{{/user_vote_is_upvoted}}{{^user_vote_is_upvoted}}false{{/user_vote_is_upvoted}}">&#x1F5A4;</button>
              <button name="vote" value="-1" title="Flag as offensive: only admins see flags, and not who sent them" aria-pressed="{{#user_vote_is_downvoted}}true{{/user_vote_is_downvoted}}{{^user_vote_is_downvoted}}false{{/user_vote_is_downvoted}}">&#x2691;</button>
            </form>
            {{/can_vote}}
            {{#flags}}
            <a href="{{baseurl}}approvals#flagged"><strong>&#x2691; {{flags}} flagged</strong></a>
            {{/flags}}
            {{#has_reactions}}
            <span class="reactions">&#x1F5A4;
              {{#reactions}}<a href="{{baseurl}}profile/{{user_id}}" class="avatar {{avatar}}" title="{{username}}" aria-label="{{username}}">{{initial}}</a>{{/reactions}}
            </span>
            {{/has_reactions}}
        </span>
        <article>
            {{{content}}}
        </article>
    </li>
{{/posts}}
</ol>
{{#has_pagination}}
<ol class="pagination">
    {{#pages}}
    <li{{#is_active}} class="active"{{/is_active}}>{{#page}}<a href="{{baseurl}}thread/{{id}}/p{{page}}">{{#is_first}}Page {{/is_first}}{{page}}</a>{{/page}}{{^page}}<span>…</span>{{/page}}</li>
    {{/pages}}
</ol>
{{/has_pagination}}
{{#is_logged_in}}
<p>Posts can be formatted using <a href="https://en.wikipedia.org/wiki/Markdown">Markdown</a>.</p>
<p><a href="{{baseurl}}upload" id="upload-link">Attach file?</a> <small>(images, txt, zip, pdf, and ifc)</small></p>
{{#has_errors}}
<p><strong>Uh oh</strong>. Your post has issues:</p>
<ul class="errors">
{{#errors}}
    <li>{{.}}</li>
{{/errors}}
</ul>
{{/has_errors}}
<form action="" method="post">
    <input type="hidden" name="csrf" value="{{csrf}}" />
    <textarea name="content" id="content"></textarea>
    <input type="submit" value="Reply" />
</form>
<script src="{{baseurl}}marked.min.js"></script>
<script src="{{baseurl}}purify.min.js"></script>
<script src="{{baseurl}}post.js"></script>
{{/is_logged_in}}
{{^is_logged_in}}
<p>
    <a href="{{baseurl}}login">Login or Register</a> to reply.
</p>
{{/is_logged_in}}
